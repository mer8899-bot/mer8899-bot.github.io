# Public origin of the portable Node backend, without a trailing slash.
APP_ORIGIN=http://127.0.0.1:8787

# GitHub App identity and repository installation.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=

# GitHub App OAuth credentials used only by the server.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Stable numeric GitHub user ID of the only authorized author.
AUTHORIZED_GITHUB_USER_ID=

# Generate a long random value for production.
SESSION_SECRET=

REPO_OWNER=mer8899-bot
REPO_NAME=mer8899-bot.github.io
